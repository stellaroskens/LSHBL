# Public site configuration. Do not put secrets in VITE_* variables.
# Leave the contact email empty until the league publishes an official address.
# VITE_CONTACT_EMAIL=

# Future server-only settings. Set these in the Netlify UI, not in git.
# Do not point them at the original WAHSB repository or its Identity project.
# ADMIN_AUTH_ENABLED=false
# GITHUB_CONTENT_OWNER=stellaroskens
# GITHUB_CONTENT_REPO=LSHBL
# GITHUB_CONTENT_BRANCH=main
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
